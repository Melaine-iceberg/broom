<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:broom.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
        x:Class="broom.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="broom · 垃圾清理"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="580"
        Background="{DynamicResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="208,*">

        <!-- ══════════ 侧边栏 ══════════ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,16,8,24" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="b" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="broom" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="muted" Text="垃圾清理与磁盘瘦身" Margin="40,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,0">
                    <Border Classes="badge admin" IsVisible="{Binding IsElevated}" Padding="10,6"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="已以管理员身份运行" HorizontalAlignment="Center"/>
                    </Border>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="以管理员身份重启" IsVisible="{Binding !IsElevated}"
                            IsEnabled="{Binding !IsBusy}" Command="{Binding RestartElevatedCommand}"
                            ToolTip.Tip="通过 UAC 以管理员身份重新启动,用于清理需要管理员权限的项目。"/>
                    <Border Classes="divider" Margin="4,4"/>
                    <TextBlock Classes="muted" Margin="8,0,8,4" TextWrapping="Wrap"
                               Text="删除默认移入回收站,可恢复"/>
                </StackPanel>

                <StackPanel Spacing="4" Margin="4,0">
                    <Button Classes="nav" Classes.active="{Binding IsCleanPage}"
                            Command="{Binding ShowCleanCommand}" Content="清理"
                            ToolTip.Tip="扫描并清理临时文件、缓存与残留。"/>
                    <Button Classes="nav" Classes.active="{Binding IsSettingsPage}"
                            Command="{Binding ShowSettingsCommand}" IsEnabled="{Binding !IsBusy}" Content="设置"
                            ToolTip.Tip="自定义清理目录、排除规则与默认选项。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════ 内容 ══════════ -->
        <Grid Grid.Column="1">

            <!-- ──────── 清理页 ──────── -->
            <Grid IsVisible="{Binding IsCleanPage}" Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">

                <!-- 总览 + 主操作 -->
                <Border Grid.Row="0" Classes="hero">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="section" Text="可释放空间"/>
                            <TextBlock Text="{Binding TotalSizeText}" FontSize="40" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}" LineHeight="46"/>
                            <TextBlock Classes="body" Text="{Binding SelectedSummaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Button Classes.accent="{Binding !HasScanned}" Classes.secondary="{Binding HasScanned}"
                                    HorizontalAlignment="Right" MinWidth="168"
                                    Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Classes="secondary" Content="取消" Command="{Binding CancelCommand}"
                                        IsVisible="{Binding IsBusy}"/>
                                <Button Classes.accent="{Binding HasScanned}" Classes.secondary="{Binding !HasScanned}"
                                        MinWidth="168" HorizontalAlignment="Right"
                                        Content="{Binding CleanButtonText}" Command="{Binding CleanCommand}"
                                        IsEnabled="{Binding CanClean}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 进度与状态 -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="8">
                    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                                 IsVisible="{Binding IsProgressVisible}"/>
                    <TextBlock Classes="body" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 筛选工具栏 -->
                <Grid Grid.Row="2" Margin="0,16,0,12" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Classes="h2" Text="清理项" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0"
                               Text="{Binding VisibleCountText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="全选" Command="{Binding SelectAllVisibleCommand}"/>
                        <Button Classes="ghost" Content="仅安全" Command="{Binding SelectSafeOnlyCommand}"/>
                        <Button Classes="ghost" Content="全不选" Command="{Binding SelectNoneVisibleCommand}"/>
                    </StackPanel>
                    <TextBox Grid.Column="3" Width="220" VerticalAlignment="Center"
                             Text="{Binding SearchText}" PlaceholderText="搜索清理项…"
                             ToolTip.Tip="按名称、说明或类别过滤。"/>
                    <ComboBox Grid.Column="4" Width="132" Margin="8,0,0,0"
                              ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding SelectedRiskFilter}"
                              ToolTip.Tip="按风险等级筛选。">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RiskFilterOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="5" Width="168" Margin="8,0,0,0"
                              ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              ToolTip.Tip="调整清理项的排列顺序。">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SortOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- 清理项列表 -->
                <ScrollViewer Grid.Row="3">
                    <StackPanel Spacing="16">
                        <StackPanel IsVisible="{Binding !HasVisibleRules}" Spacing="6" Margin="0,48">
                            <TextBlock Classes="h2" Text="没有匹配的清理项" HorizontalAlignment="Center"/>
                            <TextBlock Classes="body" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       Text="换个关键词,或把风险筛选调回“全部等级”。"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding RuleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuleGroupViewModel">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected}"
                                                      ToolTip.Tip="勾选 / 取消勾选本组全部清理项"/>
                                            <TextBlock Grid.Column="1" Classes="h2" VerticalAlignment="Center"
                                                       Text="{Binding Title}"/>
                                            <TextBlock Grid.Column="2" Classes="muted" Margin="10,0,14,0"
                                                       VerticalAlignment="Center" Text="{Binding CountText}"/>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding SizeText}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RuleViewModel">
                                                    <Border Classes="row" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                            <CheckBox Grid.Column="0" Margin="0,2,12,0"
                                                                      VerticalAlignment="Top"
                                                                      IsChecked="{Binding IsSelected}"
                                                                      ToolTip.Tip="勾选后参与本次清理"/>
                                                            <StackPanel Grid.Column="1" Spacing="5">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Brush.Text}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Border Classes="badge"
                                                                            Classes.safe="{Binding IsSafe}"
                                                                            Classes.caution="{Binding IsCaution}"
                                                                            Classes.high="{Binding IsHigh}">
                                                                        <TextBlock Text="{Binding RiskText}"/>
                                                                    </Border>
                                                                    <Border Classes="badge admin"
                                                                            IsVisible="{Binding RequiresAdmin}">
                                                                        <TextBlock Text="需要管理员"/>
                                                                    </Border>
                                                                    <Border Classes="badge high"
                                                                            IsVisible="{Binding HasFailures}">
                                                                        <TextBlock Text="部分无法访问"/>
                                                                    </Border>
                                                                    <Button Classes="ghost" Padding="8,2" FontSize="11"
                                                                            VerticalAlignment="Center"
                                                                            Content="{Binding FilesToggleText}"
                                                                            Command="{Binding ToggleFilesCommand}"
                                                                            IsVisible="{Binding HasFiles}"
                                                                            ToolTip.Tip="预览本条规则命中的文件,可将个别文件排除。"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Margin="16,0,0,0" Spacing="2"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="18"
                                                                           FontWeight="SemiBold" TextAlignment="Right"
                                                                           Foreground="{DynamicResource Brush.Text}"/>
                                                                <TextBlock Classes="muted" TextAlignment="Right"
                                                                           Text="{Binding StatusText}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                                                        Margin="32,2,0,0" Spacing="6"
                                                                        IsVisible="{Binding IsFilesExpanded}">
                                                                <ItemsControl ItemsSource="{Binding Files}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:FileItemViewModel">
                                                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                                                  Margin="0,1">
                                                                                <StackPanel Grid.Column="0" Spacing="1">
                                                                                    <TextBlock Text="{Binding FileName}"
                                                                                               FontSize="12"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{DynamicResource Brush.Text}"
                                                                                               ToolTip.Tip="{Binding FullPath}"/>
                                                                                    <TextBlock Classes="muted"
                                                                                               Text="{Binding DirectoryPath}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               ToolTip.Tip="{Binding FullPath}"/>
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1" Classes="muted"
                                                                                           Margin="10,0" VerticalAlignment="Center"
                                                                                           Text="{Binding SizeText}"/>
                                                                                <StackPanel Grid.Column="2"
                                                                                            Orientation="Horizontal"
                                                                                            Spacing="4"
                                                                                            VerticalAlignment="Center">
                                                                                    <Button Classes="ghost" Padding="8,2"
                                                                                            FontSize="11" Content="打开位置"
                                                                                            Command="{Binding RevealCommand}"/>
                                                                                    <Button Classes="ghost" Padding="8,2"
                                                                                            FontSize="11" Content="排除"
                                                                                            Command="{Binding ExcludeCommand}"
                                                                                            ToolTip.Tip="加入排除名单:清理时跳过该文件,后续扫描不再列出。"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Classes="ghost" HorizontalAlignment="Left"
                                                                        Padding="8,2" FontSize="11"
                                                                        Content="{Binding ShowMoreText}"
                                                                        Command="{Binding ShowMoreFilesCommand}"
                                                                        IsVisible="{Binding HasMoreFiles}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 清理报告 -->
                <Border Grid.Row="4" Classes="card" Margin="0,16,0,0" MaxHeight="230"
                        IsVisible="{Binding HasReport}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="h2" Text="清理报告"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                    Margin="0,12,0,0" IsVisible="{Binding HasPendingRebootDeletes}">
                            <Button Classes="secondary" Content="{Binding ScheduleRebootDeleteText}"
                                    Command="{Binding ScheduleRebootDeleteCommand}"
                                    ToolTip.Tip="登记到系统重启队列,重启后生效;重启前文件仍占用空间。"/>
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsElevated}"
                                       Text="需要管理员权限 —— 请先以管理员身份重启。"/>
                        </StackPanel>
                        <ScrollViewer Margin="0,10,0,0">
                            <TextBlock Text="{Binding ReportText}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ──────── 设置页 ──────── -->
            <ScrollViewer IsVisible="{Binding IsSettingsPage}" Margin="24">
                <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h1" Text="设置"/>
                        <TextBlock Classes="body" TextWrapping="Wrap"
                                   Text="自定义清理目录、排除规则与默认选项。修改后点击“保存设置”才会生效。"/>
                    </StackPanel>

                    <!-- 自定义目录 -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="h2" Text="自定义目录" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="secondary" Content="添加目录"
                                        Command="{Binding SettingsEditor.AddCustomRuleCommand}"/>
                            </Grid>
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="这些目录会作为自定义规则出现在清理页,可扫描、可清理。路径支持 %ENV% 环境变量与目录级通配符(*)。"/>
                            <ItemsControl ItemsSource="{Binding SettingsEditor.CustomRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CustomRuleViewModel">
                                        <Border Classes="card" Padding="14" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                    <TextBlock Classes="muted" Text="名称(可留空)"/>
                                                    <TextBox Text="{Binding Name}" PlaceholderText="例如:我的下载缓存"/>
                                                </StackPanel>
                                                <Button Grid.Row="0" Grid.Column="1" Classes="danger"
                                                        Content="删除" Command="{Binding RemoveCommand}"
                                                        VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                            Spacing="2" Margin="0,12,0,0">
                                                    <TextBlock Classes="muted"
                                                               Text="路径(支持 %ENV% 与目录级通配符 *)"/>
                                                    <TextBox Text="{Binding Path}"
                                                             PlaceholderText="%LOCALAPPDATA%\MyApp\Cache"/>
                                                </StackPanel>
                                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                      Margin="0,12,0,0" ColumnDefinitions="*,*,Auto,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Classes="muted" Text="包含模式(逗号分隔)"/>
                                                        <TextBox Text="{Binding IncludePatternsText}" PlaceholderText="*"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                                                        <TextBlock Classes="muted" Text="排除模式(逗号分隔)"/>
                                                        <TextBox Text="{Binding ExcludePatternsText}"
                                                                 PlaceholderText="*.db, *.log"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="2" Margin="10,0,0,0">
                                                        <TextBlock Classes="muted" Text="风险等级"/>
                                                        <ComboBox ItemsSource="{Binding RiskOptions}"
                                                                  SelectedItem="{Binding SelectedRisk}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:RiskOption">
                                                                    <TextBlock Text="{Binding Label}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="3" Margin="10,20,0,0"
                                                              Content="默认勾选" IsChecked="{Binding Recommended}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 排除规则 -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="h2" Text="排除规则"/>
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="每行一个路径,命中的文件在任何规则下都会被跳过(包含该目录下的所有内容)。"/>
                            <TextBox AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding SettingsEditor.ExcludedPathsText}"
                                     PlaceholderText="例如:C:\Users\me\AppData\Local\Temp\keep"/>
                        </StackPanel>
                    </Border>

                    <!-- 排除的文件 -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h2" Text="排除的文件"/>
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="每行一个文件路径,命中的文件在任何规则下都会被跳过;在清理页的文件明细中点击“排除”会自动添加到这里。"/>
                            <TextBox AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding SettingsEditor.ExcludedFilesText}"
                                     PlaceholderText="例如:C:\Users\me\AppData\Local\Temp\keep\important.tmp"/>
                        </StackPanel>
                    </Border>

                    <!-- 其他选项 -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h2" Text="其他选项"/>
                            <CheckBox Content="默认使用永久删除(不经过回收站)"
                                      IsChecked="{Binding SettingsEditor.DefaultPermanentDelete}"/>
                            <CheckBox Content="显示高风险类目(例如旧系统备份)"
                                      IsChecked="{Binding SettingsEditor.ShowHighRiskRules}"/>
                        </StackPanel>
                    </Border>

                    <!-- 保存栏 -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="accent" Content="保存设置"
                                Command="{Binding SettingsEditor.SaveCommand}"/>
                        <Button Classes="secondary" Content="放弃更改"
                                Command="{Binding SettingsEditor.CancelCommand}"
                                ToolTip.Tip="丢弃本次未保存的修改,恢复到当前生效的设置。"/>
                        <TextBlock Classes="error" VerticalAlignment="Center" MaxWidth="420"
                                   TextWrapping="Wrap" Text="{Binding SettingsEditor.ErrorText}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
