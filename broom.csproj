<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 发布元数据:exe 图标与文件属性(版本以这里为准,打包脚本从此处读取) -->
    <ApplicationIcon>Assets\broom.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>broom</Product>
    <AssemblyTitle>broom</AssemblyTitle>
    <Description>Windows 垃圾清理工具</Description>
    <Company>broom</Company>
    <Copyright>Copyright © 2026 broom</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试项目位于子目录,避免主工程的默认通配把它编进来 -->
    <Compile Remove="broom.Tests\**" />
    <None Remove="broom.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="broom.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\broom.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>
</Project>
